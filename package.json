{
  "name": "orbit-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-docs.mjs && node scripts/fetch-release.mjs && vite-node scripts/generate-docs-index.mts",
    "dev": "vite",
    "prebuild": "node scripts/fetch-docs.mjs && node scripts/fetch-release.mjs && vite-node scripts/generate-docs-index.mts && vite-node scripts/generate-sitemap.mts",
    "build": "tsc -b && vite build",
    "postbuild": "vite-node scripts/prerender.mts",
    "lint": "eslint .",
    "preview": "vite preview",
    "fetch-docs": "node scripts/fetch-docs.mjs && node scripts/fetch-release.mjs && vite-node scripts/generate-docs-index.mts"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "refractor": "^5.0.0",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0"
  }
}
